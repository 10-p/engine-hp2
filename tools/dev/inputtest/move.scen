# The move stick: the speed at five tilts straight ahead, the player's Walking button held at full tilt and the stick
# after that button's release, then the turn rate and the move direction at stick angles between the axes at full and
# at 0.4 tilt (the shipped layout turns Harry with the stick's X: Axis aBaseX). Every sample starts at one spot of
# GreatHall_G with 500 units free ahead while Harry faces yaw 0; the hall's camera keeps the yaw a turn left, so the
# turning samples come last and their acceleration's direction, not their speed, is the measure. A small tilt is
# given the time it takes to reach full speed:
#   tools/dev/inputtest/run.sh <run-tree> move.scen <out-dir> GreatHall_G -NULLRENDERER
#   tools/dev/inputtest/rate.py <out-dir>/game.log 0
# The tags name the tilt and the stick's angle in degrees clockwise from straight ahead (speed-0.4: 0.4 ahead;
# dir-0.4-30: 0.4 at 30 degrees).
waitlog GreatHall_G.*up for play
sleep 6
pad attach
sleep 1
# The pad's Y button as the Walking button (the shipped layout has none).
exec set input Joy4 Walking
exec TELEPORT 1110 -899 -275 0
sleep 0.3
pad axis lefty -6553
sleep 3.0
watch 20 speed-0.2
sleep 0.8
pad axis lefty 0
sleep 0.8
exec TELEPORT 1110 -899 -275 0
sleep 0.3
pad axis lefty -13107
sleep 1.7
watch 20 speed-0.4
sleep 0.8
pad axis lefty 0
sleep 0.8
exec TELEPORT 1110 -899 -275 0
sleep 0.3
pad axis lefty -19660
sleep 1.3
watch 20 speed-0.6
sleep 0.8
pad axis lefty 0
sleep 0.8
exec TELEPORT 1110 -899 -275 0
sleep 0.3
pad axis lefty -26214
sleep 1.1
watch 20 speed-0.8
sleep 0.8
pad axis lefty 0
sleep 0.8
exec TELEPORT 1110 -899 -275 0
sleep 0.3
pad axis lefty -32767
sleep 0.9
watch 20 speed-1.0
sleep 0.8
pad axis lefty 0
sleep 0.8
exec TELEPORT 1110 -899 -275 0
sleep 0.3
pad button y 1
pad axis lefty -32767
sleep 0.9
watch 20 walkbutton-1.0
sleep 0.8
pad axis lefty 0
pad button y 0
sleep 0.8
exec TELEPORT 1110 -899 -275 0
sleep 0.3
pad button y 1
pad axis lefty -32767
sleep 0.6
pad button y 0
sleep 0.9
watch 20 walkbutton-released-1.0
sleep 0.8
pad axis lefty 0
sleep 0.8
exec TELEPORT 1110 -899 -275 0
sleep 0.3
pad button y 1
pad axis lefty -13107
sleep 0.6
pad button y 0
sleep 1.7
watch 20 walkbutton-released-0.4
sleep 0.8
pad axis lefty 0
sleep 0.8
exec TELEPORT 1110 -899 -275 0
sleep 0.3
pad axis leftx 5690
pad axis lefty -32269
sleep 0.8
watch 20 dir-1.0-10
sleep 0.8
pad axis leftx 0
pad axis lefty 0
sleep 0.8
exec TELEPORT 1110 -899 -275 0
sleep 0.3
pad axis leftx 16383
pad axis lefty -28377
sleep 0.8
watch 20 dir-1.0-30
sleep 0.8
pad axis leftx 0
pad axis lefty 0
sleep 0.8
exec TELEPORT 1110 -899 -275 0
sleep 0.3
pad axis leftx 28377
pad axis lefty -16384
sleep 0.8
watch 20 dir-1.0-60
sleep 0.8
